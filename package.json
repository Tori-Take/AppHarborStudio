{
  "name": "appharbor-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AppHarbor Studio — カートリッジ開発・検証スタジオ（フォルダ単独動作）",
  "scripts": {
    "predev": "node scripts/sync-types-if-parent-exists.js && node scripts/fetch-cartridges.js && node scripts/mount-cartridges.js",
    "dev": "node scripts/dev-supervisor.js",
    "dev:raw": "next dev --webpack -p 3200",
    "prebuild": "node scripts/sync-types-if-parent-exists.js && node scripts/fetch-cartridges.js && node scripts/mount-cartridges.js",
    "mount": "node scripts/mount-cartridges.js",
    "cart:fetch": "node scripts/fetch-cartridges.js",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "sync-types": "node scripts/sync-types.js",
    "verify-standalone": "node scripts/check-no-parent-imports.js",
    "init-project": "node scripts/init-project.js",
    "mcp": "node mcp/server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@appharbor/sdk": "github:Tori-Take/appharbor-sdk#v0.5.2",
    "@base-ui/react": "^1.4.1",
    "@electric-sql/pglite": "^0.4.5",
    "@supabase/supabase-js": "^2.105.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6",
    "vitest": "^4.1.8",
    "zod": "^4.4.1"
  }
}
